@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <div class="text-center mb-4">
        <i class="fa-solid fa-book-open fa-2x text-primary"></i>
        <h3 class="mt-2">Library Management System</h3>
        <p class="text-muted mb-0">Admin Login</p>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="mb-3">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" required autofocus />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-right-to-bracket"></i> Login</button>

        <div class="form-text mt-3 text-center">
            Default demo credentials: <code>admin</code> / <code>admin123</code>
            <br />(change in <code>appsettings.json</code> under <code>AdminAccount</code>)
        </div>
    </form>
</div>
