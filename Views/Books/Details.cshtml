@model Book
@{
    ViewData["Title"] = "Book Details";
}

<h2><i class="fa-solid fa-book"></i> Book Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.Author</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Model.ISBN</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Copies</dt>
            <dd class="col-sm-9">@Model.AvailableCopies available of @Model.TotalCopies total</dd>

            <dt class="col-sm-3">Added On</dt>
            <dd class="col-sm-9">@Model.AddedOn.ToString("MMM dd, yyyy")</dd>
        </dl>
    </div>
</div>

<h4><i class="fa-solid fa-clock-rotate-left"></i> Loan History</h4>
<div class="card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Return Date</th>
                    <th>Status</th>
                    <th>Fine</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.BorrowRecords.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No loan history for this book.</td></tr>
                }
                @foreach (var r in Model.BorrowRecords.OrderByDescending(r => r.BorrowDate))
                {
                    <tr>
                        <td>@r.Member?.FullName</td>
                        <td>@r.BorrowDate.ToString("MMM dd, yyyy")</td>
                        <td>@r.DueDate.ToString("MMM dd, yyyy")</td>
                        <td>@(r.ReturnDate.HasValue ? r.ReturnDate.Value.ToString("MMM dd, yyyy") : "-")</td>
                        <td>
                            <span class="badge @(r.IsReturned ? "badge-status-returned" : (r.IsOverdue ? "badge-status-overdue" : "badge-status-borrowed"))">
                                @r.Status
                            </span>
                        </td>
                        <td>
                            @if (r.Fine > 0)
                            {
                                <span class="text-danger fw-bold">₹@r.Fine.ToString("0.00")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="fa-solid fa-pen"></i> Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
